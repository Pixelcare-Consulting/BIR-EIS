# Copy to .env.local and fill in secrets. Never commit .env.local.

# Session signing (generate a long random string)
AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# App origin for Better Auth callbacks
BETTER_AUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# PostgreSQL — Prisma Client (app runtime)
# Neon / cloud: use sslmode=verify-full (recommended). Avoid bare sslmode=require —
# node-pg currently aliases prefer/require/verify-ca to verify-full and warns until pg v9.
# To opt into future libpq semantics instead: uselibpqcompat=true&sslmode=require
#
# Local Postgres without TLS can omit sslmode:
# DATABASE_URL="postgresql://bir_eis:bir_eis@localhost:5432/bir_eis"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Migrations / Prisma CLI (same as DATABASE_URL without a pooler when using Neon)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# Credential vault encryption (32+ byte secret)
CREDENTIALS_ENCRYPTION_KEY=replace-me-with-a-long-random-secret

# Optional local uploads root
STORAGE_ROOT=.data/uploads
